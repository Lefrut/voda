<resources>

    <style name="Theme.Vodovoz" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/new_product_blue</item>
        <item name="colorPrimaryDark">@color/new_product_blue</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorAccent">@color/new_product_blue</item>
        <item name="colorControlActivated">@color/new_product_blue</item>
        <item name="materialAlertDialogTheme">@style/AlertDialog</item>
        <item name="android:statusBarColor">@color/white</item>
        <item name="popupMenuStyle">@style/Vodovoz.PopupMenu</item>
    </style>

    <style name="Theme.AppSplash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/new_product_blue</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
        <item name="windowSplashScreenAnimationDuration">0</item>
        <item name="postSplashScreenTheme">@style/Theme.Vodovoz</item>"
        <item name="popupMenuStyle">@style/Vodovoz.PopupMenu</item>
    </style>

    <style name="Vodovoz.PopupMenu" parent="android:Widget.Material.PopupMenu">
        <item name="android:popupElevation">0dp</item>
    </style>

    <style name="AlertDialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="materialAlertDialogBodyTextStyle">@style/TextViewNormalBlack</item>
    </style>

    <style name="TextField">
        <item name="android:textColor">@color/text_black_composable</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textAppearance">@style/TextAppearance.Vodovoz.Body1</item>
        <item name="android:background">@color/white</item>
    </style>



    //ReallySmall

    <style name="TextViewReallySmallGrey" parent="@style/Theme.AppCompat">
        <item name="android:textSize">9sp</item>
        <item name="android:textColor">@color/text_grey_composable</item>
        <item name="fontFamily">@font/rotonda_normal</item>
    </style>

    //Normal

    <style name="TextViewNormalBlack" parent="@style/Theme.AppCompat">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_black_composable</item>
        <item name="fontFamily">@font/rotonda_normal</item>
    </style>


    <style name="TextViewNormalBlackBold" parent="@style/TextViewNormalBlack">
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_black_composable</item>
        <item name="fontFamily">@font/rotonda_normal</item>
    </style>

    //Medium

    <style name="TextViewMediumBlack" parent="@style/Theme.AppCompat">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/text_black_composable</item>
        <item name="fontFamily">@font/rotonda_normal</item>
    </style>

    <style name="TextViewMediumBlackBold" parent="@style/TextViewMediumBlack">
        <item name="android:textStyle">bold</item>
    </style>





    //Search

    <style name="EditTextSearch" parent="@style/Theme.AppCompat">
        <item name="android:textSize">@dimen/normal_text_size</item>
        <item name="android:textColor">@color/text_black</item>
        <item name="fontFamily">@font/rotonda_normal</item>
        <item name="android:textColorHint">@color/text_gray</item>
    </style>

    //Button

    <style name="BaseButton" parent="@style/Theme.AppCompat">
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="BottomNavigationView" parent="@style/TextAppearance.AppCompat.Caption">
        <item name="android:textSize">10sp</item>
        <item name="android:fontFamily">@font/rotonda_normal</item>
    </style>

    <style name="BottomNavigationView.Active" parent="@style/TextAppearance.AppCompat.Caption">
        <item name="android:textSize">10sp</item>
        <item name="android:fontFamily">@font/rotonda_normal</item>
    </style>

</resources>